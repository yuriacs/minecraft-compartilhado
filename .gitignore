# Baixados automaticamente em cada PC
.runtime/
server/*.jar

# Gerados pelo servidor, nao fazem parte do mundo
server/logs/
server/cache/
server/libraries/
server/versions/
server/crash-reports/
server/.console_history
server/plugins/.paper-remapped/
**/session.lock

# Cache do servidor Fabric
server/.fabric/

# Gerados pelo instalador do Forge/NeoForge em cada PC
server/run.bat
server/run.sh
server/user_jvm_args.txt
server/*.log

# Instalador gerado localmente
dist/
